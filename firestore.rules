rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down all collections by default so all data modifications must go through server API
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Public products can be read by clients for fast rendering if needed
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
